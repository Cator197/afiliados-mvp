# Ambiente
# Use production/prod em producao para ativar validacoes rigidas e cookie seguro.
APP_ENV=development
DEBUG=false
FLASK_HOST=0.0.0.0
PORT=5000

# Armazenamento sensivel
# Defina um diretorio privado fora da pasta publica/deploy do app.
SECURE_STORAGE_DIR=~/.afiliados-mvp

# Segredos obrigatorios
# Gere valores fortes, por exemplo:
# python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=
WORKER_API_TOKEN=

# Sessao Flask
# Em producao, SESSION_COOKIE_SECURE e forcado para true pelo config.py.
SESSION_COOKIE_SECURE=false
SESSION_LIFETIME_MINUTES=480

# Rate limit por IP
RATE_LIMIT_WINDOW_SECONDS=600
RATE_LIMIT_BLOCK_SECONDS=900
ADMIN_LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
USER_LOGIN_RATE_LIMIT_MAX_ATTEMPTS=10
PASSWORD_RESET_RATE_LIMIT_MAX_ATTEMPTS=5

# SQLite
SQLITE_BUSY_TIMEOUT_MS=5000

# Bootstrap admin opcional
ADMIN_DEFAULT_USERNAME=
ADMIN_DEFAULT_PASSWORD=

# Worker remoto
WORKER_ENABLED=true
WORKER_ID=local-worker
WORKER_POLL_INTERVAL_SECONDS=5
WORKER_HEARTBEAT_INTERVAL_SECONDS=15
WORKER_INACTIVE_THRESHOLD_SECONDS=45
JOB_TIMEOUT_SECONDS=900
VPS_BASE_URL=

# Selenium / Chrome
CHROME_HEADLESS=false
CHROME_DISPLAY=
CHROME_BINARY_PATH=
CHROMEDRIVER_PATH=
CHROME_USE_WEBDRIVER_MANAGER_FALLBACK=false
CHROME_PROFILE_DIR=
