[Unit]
Description=Gunicorn for afiliados-mvp
After=network.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/afiliados-mvp
EnvironmentFile=/home/ubuntu/afiliados-mvp/.env
Environment=PYTHONUNBUFFERED=1
ExecStartPre=/usr/bin/mkdir -p /home/ubuntu/.afiliados-mvp/logs
ExecStart=/home/ubuntu/afiliados-mvp/venv/bin/gunicorn app:app --bind 127.0.0.1:5000 --workers 1 --timeout 120
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
